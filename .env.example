# Application
APP_NAME=Flokka Ingestion Engine
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=flokka_documents

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Chunking
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64

# Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
